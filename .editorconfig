root = true

[*]
charset = utf-8

[*.{cs}]
dotnet_diagnostic.IDE0090.severity = none
dotnet_diagnostic.IDE0017.severity = none

dotnet_diagnostic.IDE0057.severity = none # Substring можно упростить
dotnet_diagnostic.IDE0300.severity = none # Инициализацию коллекции можно упростить
dotnet_diagnostic.IDE0305.severity = none # Использовать выражение коллекции
dotnet_diagnostic.IDE0018.severity = none # Объявление переменной может быть встроенным

csharp_new_line_before_open_brace = none